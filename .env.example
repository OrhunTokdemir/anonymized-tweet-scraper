# Easiest: add Twitter accounts in the app's Accounts & settings tab (python -m scraper).
# It creates .env from this file and fills in the account lines for you.
# Manual alternative: cp .env.example .env, then edit it.
# .env is gitignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Twitter/X accounts for twscrape
# Add as many as you want: TW_ACCOUNT_1_*, TW_ACCOUNT_2_*, TW_ACCOUNT_3_* ...
# Numbering must be continuous (1, 2, 3 ...).
#
# Cookie login is strongly recommended. X often blocks password logins.
# To get cookies: log in at x.com in a browser > DevTools > Application >
# Cookies > copy the values of `auth_token` and `ct0`.
# If COOKIES is set, PASSWORD/EMAIL can be left empty.
# Use only accounts you are entitled to use, and keep your personal account out of it.
# ---------------------------------------------------------------------------
TW_ACCOUNT_1_USERNAME=your_twitter_username
TW_ACCOUNT_1_PASSWORD=
TW_ACCOUNT_1_EMAIL=
TW_ACCOUNT_1_EMAIL_PASSWORD=
TW_ACCOUNT_1_COOKIES="auth_token=xxxxxxxx; ct0=yyyyyyyy"
# Optional: HTTP proxy for this account (e.g. if your network requires one)
TW_ACCOUNT_1_PROXY=
# Optional: TOTP secret if the account has 2FA (password login only)
TW_ACCOUNT_1_MFA_CODE=

TW_ACCOUNT_2_USERNAME=
TW_ACCOUNT_2_PASSWORD=
TW_ACCOUNT_2_EMAIL=
TW_ACCOUNT_2_EMAIL_PASSWORD=
TW_ACCOUNT_2_COOKIES=
TW_ACCOUNT_2_PROXY=

# ---------------------------------------------------------------------------
# Pacing / rate limits
# ---------------------------------------------------------------------------
# Tweets fetched per search chunk. With several accounts, the next chunk goes to
# the least-recently-used one. A rate-limited account is not used again until
# its limit resets; the scraper does not try to evade blocks or suspensions.
TW_ROTATE_EVERY=40
# Random pause (seconds) between chunks
TW_DELAY_MIN=3
TW_DELAY_MAX=8
# twscrape's local account/session database (gitignored, contains cookies)
TWSCRAPE_DB=accounts.db

# ---------------------------------------------------------------------------
# Ekşi Sözlük (no account needed, anonymous mobile API token)
# ---------------------------------------------------------------------------
# For "search" and "gundem" methods: max entries taken from a single topic
EKSI_MAX_PER_TOPIC=10

# ---------------------------------------------------------------------------
# Offensive batch (default lexicon path shown in the app; editable there too)
# ---------------------------------------------------------------------------
OFFENSIVE_LEXICON=lexicons/tr_offensive.txt

# ---------------------------------------------------------------------------
# Output / anonymization
# ---------------------------------------------------------------------------
# Where CSV files go. Leave it commented out for the default:
#   running from source / portable build: data/ next to this file
#   standard build: <your Documents folder>/anonymized-posts
# Easiest: change it in the app (Accounts & settings -> Output folder).
# OUTPUT_DIR=
